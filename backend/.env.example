APP_NAME="CogniFlow AI Backend"
APP_ENV="development"
LOG_LEVEL="INFO"

POSTGRES_USER="cogniflow"
POSTGRES_PASSWORD="cogniflow_secret"
POSTGRES_DB="cogniflow_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

CORS_ORIGINS=["http://localhost:3000"]

CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_PDF_SIZE_BYTES=20971520

# Provedores de IA: apenas "ollama" é suportado nesta versão.
EMBEDDING_PROVIDER="ollama"
LLM_PROVIDER="ollama"
LLM_TEMPERATURE=0.1

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="bge-m3"
OLLAMA_LLM_MODEL="llama3.2:3b"
OLLAMA_NUM_CTX=8192
# Dimensão dos vetores gerados pelo modelo de embeddings (bge-m3 = 1024).
EMBEDDING_DIMENSION=1024

# Tutor tira-dúvidas (RAG): trechos recuperados por pergunta e similaridade mínima
# (cosseno) para considerar que o material trata da pergunta. Valor inicial para o
# bge-m3, a ser calibrado com a suíte de avaliação.
TUTOR_TOP_K=5
TUTOR_MIN_SIMILARITY=0.45
